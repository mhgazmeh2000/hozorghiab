# =============================================================================
# Freebuff Attendance Manager - Environment template
# =============================================================================
# Copy this file to `.env` and replace all placeholder values.
# DO NOT commit a real `.env` file.
#
# For local DEVELOPMENT you can run with ENVIRONMENT=development -- the server
# will auto-generate an ephemeral SECRET_KEY and use SQLite if DATABASE_URL
# is not set. For PRODUCTION, every value below marked REQUIRED must be set.

# ---- Application ----
ENVIRONMENT=development                  # development | production
DEBUG=false
API_PREFIX=/api
APP_NAME=Freebuff Attendance Manager

# ---- Database ----
# Dev default: local SQLite file. Production: postgresql+psycopg://user:pass@postgres:5432/attendance
DATABASE_URL=sqlite+aiosqlite:///./attendance.db
POSTGRES_DB=attendance
POSTGRES_USER=attendance                # REQUIRED in production
POSTGRES_PASSWORD=change-me-strong      # REQUIRED in production

# ---- Redis / jobs ----
REDIS_URL=redis://127.0.0.1:6379/0      # docker: redis://redis:6379/0
TASK_RUNNER=builtin                     # builtin (dev) | celery (prod)
RATE_LIMIT_BACKEND=memory               # memory (dev) | redis (prod)
ENABLE_SCHEDULER=true

# ---- Security / JWT ----
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=                              # REQUIRED in production; auto in dev
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_ISSUER=freebuff-attendance

# ---- Credential encryption ----
# Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Production: REQUIRED. Dev: auto-generated + persisted in local DB.
CREDENTIAL_ENCRYPTION_KEY=

# ---- Bootstrap credentials (first-run users) ----
# MUST be changed in production. If unset in development, dev-only
# passwords are used and printed to the log.
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_OPERATOR_PASSWORD=
BOOTSTRAP_VIEWER_PASSWORD=
BOOTSTRAP_FORCE=false

# ---- CORS ----
# Comma-separated list of allowed origins; "*" is dev-only.
CORS_ORIGINS=*

# ---- Device defaults ----
DEFAULT_SCAN_PORTS=4370,80,443,8080,8000,8081,4360
DEVICE_CONNECT_TIMEOUT_S=5
DEVICE_READ_TIMEOUT_S=10
DEVICE_RETRY_COUNT=2

# ---- Ports ----
API_PORT=8000
FRONTEND_PORT=5173
API_WORKERS=2
WORKER_CONCURRENCY=4
