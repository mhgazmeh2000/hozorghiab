# Application
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=replace-with-a-long-random-secret
API_PREFIX=/api

# Database
DATABASE_URL=postgresql+psycopg://attendance:attendance@postgres:5432/attendance

# Redis / jobs
REDIS_URL=redis://redis:6379/0
TASK_RUNNER=celery
ENABLE_SCHEDULER=false

# Bootstrap credentials: replace before deployment
BOOTSTRAP_ADMIN_PASSWORD=replace-admin-password
BOOTSTRAP_OPERATOR_PASSWORD=replace-operator-password
BOOTSTRAP_VIEWER_PASSWORD=replace-viewer-password
CREDENTIAL_ENCRYPTION_KEY=

# ZK defaults
DEFAULT_SCAN_PORTS=4370,80,443,8080,8000,8081
DEVICE_CONNECT_TIMEOUT_S=5
DEVICE_READ_TIMEOUT_S=10
DEVICE_RETRY_COUNT=2
